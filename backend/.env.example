# Application
APP_NAME=Knowledge Assistant API
APP_VERSION=0.1.0
APP_ENV=development

# Database setting
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=knowledge_assistant
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=True

# API
API_PREFIX=/api
API_VERSION=v1

LOG_LEVEL=DEBUG

UPLOAD_DIRECTORY="storage/uploads"
MAX_UPLOAD_SIZE=20971520
ALLOWED_CONTENT_TYPES=["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/plain"]
ALLOWED_EXTENSIONS=[".pdf",".docx",".txt"]

SUPPORTED_LLM_PROVIDERS=["ollama","openai"]

WORKER_ENABLED=True
WORKER_POLL_INTERVAL=5
WORKER_BATCH_SIZE=1
WORKER_INTERVAL_SECONDS=30

CHUNK_SIZE=1000
CHUNK_OVERLAP=200

EMBEDDING_PROVIDER="sentence_transformers"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=382

SEARCH_SIMILARITY_THRESHOLD=0.30

SEARCH_TOP_K=10
PROMPT_PROVIDER=default

LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434