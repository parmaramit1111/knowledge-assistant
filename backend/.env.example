# Application
APP_NAME=Knowledge Assistant API
APP_VERSION=0.1.0
APP_ENV=development

# Database setting
DATABASE_URL="postgresql+asyncpg://"

# API
API_PREFIX=/api
API_VERSION=v1

LOG_LEVEL=DEBUG

UPLOAD_DIRECTORY="storage/uploads"
MAX_UPLOAD_SIZE=20971520
ALLOWED_CONTENT_TYPES=["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/plain"]
ALLOWED_EXTENSIONS=[".pdf",".docx",".txt"]

SUPPORTED_LLM_PROVIDERS=["ollama","openai"]

WORKER_ENABLED=True
WORKER_POLL_INTERVAL=5
WORKER_BATCH_SIZE=1
WORKER_INTERVAL_SECONDS=30